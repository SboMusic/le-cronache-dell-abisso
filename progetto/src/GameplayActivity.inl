void Gameplay::drawActivity(sf::RenderTarget& target,const alpha::Entity& e,const Visual& v)const{
 if(e.hp<=0)return;bool building=world_.busy(e)&&e.route.empty();auto source=world_.get(e.target);bool gathering=e.kind==alpha::Kind::Worker&&e.order==alpha::Order::Gather&&e.route.empty()&&e.work>0&&source;
 auto line=[&](sf::Vector2f a,sf::Vector2f b,sf::Color color,float width){auto d=b-a;sf::RectangleShape r({alpha::distance(a,b),width});r.setPosition(a);r.setRotation(std::atan2(d.y,d.x)*180/3.14159265f);r.setFillColor(color);target.draw(r);};
 if(building||gathering){bool wood=gathering&&source->kind==alpha::Kind::Forest;float cycle=std::fmod(v.phase*1.8f+e.id*.13f,1.f),swing=std::sin(cycle*6.283185f);float angle=-.9f+swing*.9f;sf::Vector2f grip=e.pos+sf::Vector2f(14,-19),tip=grip+sf::Vector2f(std::cos(angle)*25,std::sin(angle)*25);line(grip,tip,{151,99,51},4);sf::RectangleShape head(wood?sf::Vector2f(15,11):building?sf::Vector2f(18,9):sf::Vector2f(25,5));head.setOrigin(head.getSize()/2.f);head.setPosition(tip);head.setRotation(angle*180/3.14159265f+90);head.setFillColor({204,212,205});target.draw(head);
  if(cycle>.35f&&cycle<.8f)for(int i=0;i<4;++i){float t=std::fmod(cycle*2+i*.19f,1.f);sf::CircleShape chip(wood?2.5f:2.f,wood?3:5);chip.setPosition(e.pos+sf::Vector2f(21+t*(10+i*5),-20-t*(30+i*5)+t*t*38));chip.setFillColor(wood?sf::Color(204,168,103,190):building?sf::Color(245,190,96,210):sf::Color(239,207,112,210));target.draw(chip);}
  if(building){sf::CircleShape dust(8+cycle*13,16);dust.setScale(1,.4f);dust.setPosition(e.pos+sf::Vector2f(5,-4));dust.setFillColor({180,153,111,static_cast<sf::Uint8>((1-cycle)*55)});target.draw(dust);}
 }
 if(!alpha::mobile(e.kind)&&!alpha::resource(e.kind)&&e.build>0){float progress=1-e.build/std::max(1.f,e.buildTotal);for(int side=-1;side<=1;side+=2){sf::Vector2f p=e.pos+sf::Vector2f(side*57.f,35);line(p+sf::Vector2f(0,-100*progress),p+sf::Vector2f(0,12),{143,96,51},5);line(p+sf::Vector2f(-15,-44*progress),p+sf::Vector2f(15,-44*progress),{174,124,64},4);}for(int j=0;j<3;++j)line(e.pos+sf::Vector2f(-64,32+j*8.f),e.pos+sf::Vector2f(-20,26+j*8.f),{151,104,58},5);}
 if(e.order==alpha::Order::Attack&&e.route.empty()&&e.cooldown>0&&alpha::def(e.kind).damage>0){auto enemy=world_.get(e.target);if(!enemy)return;auto d=enemy->pos-e.pos;float angle=std::atan2(d.y,d.x);if(alpha::def(e.kind).range<100){sf::VertexArray arc(sf::LineStrip,9);for(int i=0;i<9;++i){float a=angle-1.f+i*.25f;arc[i]=sf::Vertex(e.pos+sf::Vector2f(std::cos(a)*38,std::sin(a)*30-15),{246,223,166,static_cast<sf::Uint8>(140+80*std::sin(v.phase*12))});}target.draw(arc);}else if(e.cooldown>alpha::def(e.kind).cooldown*.65f){sf::CircleShape flash(6,7);flash.setPosition(e.pos+sf::Vector2f(std::cos(angle)*28,std::sin(angle)*25-22));flash.setFillColor({255,207,113,180});target.draw(flash);}}
}
