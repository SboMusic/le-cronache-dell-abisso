bool Gameplay::saveCampaign(const std::wstring& filename){
 auto notify=[&](const char* value){world_.message=commandNotice_=value;noticeTime_=5;};
 if(world_.mission<0){notify("Salvataggi disponibili nelle missioni della campagna.");return false;}std::filesystem::path dest(filename),temp(filename+L".tmp");std::error_code error;std::filesystem::create_directories(dest.parent_path(),error);if(error){notify("Impossibile creare la cartella dei salvataggi.");return false;}
 {std::ofstream out(temp);out.imbue(std::locale::classic());out<<std::setprecision(9)<<"FRONTIERE_CAMPAIGN 1\n"<<view_.getCenter().x<<' '<<view_.getCenter().y<<' '<<zoom_<<'\n';if(!world_.save(out)){notify("Salvataggio non riuscito: controlla lo spazio libero.");return false;}out.close();if(!out){notify("Salvataggio non riuscito: file precedente conservato.");return false;}}
 if(!campaignFiles::commit(temp,dest)){notify("Impossibile completare il salvataggio: file precedente conservato.");return false;}notify("Partita salvata. F10 per riprenderla.");return true;
}
bool Gameplay::loadCampaign(const std::wstring& filename){
 auto notify=[&](const char* value){world_.message=commandNotice_=value;noticeTime_=5;};
 std::filesystem::path file(filename);std::error_code error;auto size=std::filesystem::file_size(file,error);if(error||size>4*1024*1024){notify("Salvataggio assente o non valido. Partita corrente conservata.");return false;}
 std::ifstream in(file);in.imbue(std::locale::classic());std::string header;int version;float x,y,z;alpha::World candidate;if(!(in>>header>>version>>x>>y>>z)||header!="FRONTIERE_CAMPAIGN"||version!=1||!std::isfinite(x)||!std::isfinite(y)||!std::isfinite(z)||x<0||y<0||z<.65f||z>1.4f||!candidate.restore(in)||candidate.mission<0||x>candidate.width()||y>candidate.height()){notify("Salvataggio danneggiato o incompatibile. Partita corrente conservata.");return false;}
 world_=std::move(candidate);currentMission_=world_.mission;factionChoice_=world_.faction[0];zoom_=z;view_.setSize(1423*z,976*z);view_.setCenter(x,y);constrainCamera();visuals_.clear();updateVisuals(0);for(auto& item:visuals_)if(!world_.get(item.first))item.second.death=.65f;
 cheatOpen_=false;cheatInput_.clear();
 dragging_=placing_=casting_=planting_=panning_=minimapDragging_=commandBuild_=paused_=false;catalogMode_=-1;cursorOrder_=commandPage_=0;builder_=-1;noticeTime_=0;world_.message=commandNotice_="Partita ripresa. "+world_.missionObjective();noticeTime_=5;return true;
}
