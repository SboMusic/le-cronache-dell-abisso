void Gameplay::minimapCamera(sf::Vector2f ui){auto r=minimapBounds();view_.setCenter(std::clamp((ui.x-r.left)/r.width,0.f,1.f)*world_.width(),std::clamp((ui.y-r.top)/r.height,0.f,1.f)*world_.height());constrainCamera();}
void Gameplay::dragCamera(sf::Vector2i pixel){auto size=ng::Main::getWindowPtr()->getSize();auto bounds=getGlobalBounds();auto viewSize=view_.getSize();view_.move((panPixel_.x-pixel.x)*viewSize.x/(size.x*bounds.width/1920.f),(panPixel_.y-pixel.y)*viewSize.y/(size.y*bounds.height/1080.f));panPixel_=pixel;constrainCamera();}
sf::Vector2f Gameplay::edgeDirection(sf::Vector2f,sf::Vector2f)const{return {};}
int Gameplay::pickEntity(sf::Vector2f p,bool resourcesOnly)const{int id=-1;float depth=-1e9;for(const auto& e:world_.entities)if(e.hp>0&&e.carrier<0&&world_.detected(e,0)&&knownEntity(e)&&(!resourcesOnly||alpha::resource(e.kind)||e.kind==alpha::Kind::OilRig)&&hitEntity(e,p)&&e.pos.y>=depth){depth=e.pos.y;id=e.id;}return id;}
bool Gameplay::selectedWorkersGather(int id){auto target=world_.get(id);if(!target)return false;bool done=false;for(auto& e:world_.entities)if(e.selected&&e.hp>0&&e.team==0&&((e.kind==alpha::Kind::Worker&&(target->kind==alpha::Kind::Forest||target->kind==alpha::Kind::Mine))||(e.kind==alpha::Kind::CrystalMiner&&target->kind==alpha::Kind::CrystalCave))){e.duty=0;world_.gather(e,id);done=true;}return done;}

